rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function storeSellerId(storeId) {
      return get(/databases/$(database)/documents/stores/$(storeId)).data.sellerId;
    }

    function touchesAny(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ---- users ------------------------------------------------------
    // A user can read/update their own document; admins can read/update
    // anyone's. `role` is the one field a user can never change on
    // themselves — otherwise any signed-in user could grant themselves
    // 'admin' and pass every role() == 'admin' check in this ruleset.
    // Custom claims would remove this class of rule entirely; until then,
    // this is the load-bearing check. Subscription state is likewise
    // self-write-blocked (but self-create-allowed, since signUpSeller
    // legitimately sets sellerStatus: pendingApproval) — only the
    // intasendWebhook Cloud Function may activate a subscription; see
    // `subscriptions/{sellerId}` below.
    match /users/{uid} {
      allow read: if isOwner(uid) || role() == 'admin';
      allow create: if isOwner(uid);
      allow update: if role() == 'admin' ||
        (isOwner(uid) && request.resource.data.role == resource.data.role &&
         !touchesAny(['subscriptionPlanId', 'subscriptionActiveUntil', 'sellerStatus']));
      allow delete: if false;
    }

    // ---- stores (multi-tenant storefronts) -----------------------------
    // Publicly readable, same as `listings` below — a prospective buyer
    // has to be able to browse stores before they have an account. Only
    // the owning seller (or admin) can create/update their own store.
    match /stores/{storeId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.sellerId == request.auth.uid || role() == 'admin');
      allow delete: if false;

      // ---- per-store customers (buyer-as-tenant profile) ---------------
      // Deliberately its own subcollection rather than a field on the
      // global `users` doc, so a seller can be granted read access to
      // their own store's customers without ever touching the
      // platform-wide `users` collection (see WORKLOG.md — this is what
      // decision #2 in the multi-tenant design doc is for).
      match /customers/{uid} {
        allow read: if isOwner(uid) || (isSignedIn() && storeSellerId(storeId) == request.auth.uid) || role() == 'admin';
        allow create: if isOwner(uid);
        allow update: if isOwner(uid) || role() == 'admin';
        allow delete: if false;
      }

      // ---- per-store products (tenant-scoped catalog) -------------------
      // Same public-read shape as the legacy flat `listings` collection —
      // a storefront must be browsable by guests — but writes are checked
      // against this store's own sellerId rather than a bare role check,
      // so one seller cannot write into another seller's store.
      match /products/{productId} {
        allow read: if true;
        allow create, update: if isSignedIn() && storeSellerId(storeId) == request.auth.uid;
        allow delete: if false;
      }

      // ---- per-store orders (tenant-scoped) ------------------------------
      // Mirrors the flat `orders` collection's ownership checks, scoped to
      // this store so a seller can never read/update another store's
      // orders even if they guess an order id.
      match /orders/{orderId} {
        allow create: if isSignedIn() && request.resource.data.buyerId == request.auth.uid;
        allow read: if isSignedIn() &&
          (resource.data.buyerId == request.auth.uid || storeSellerId(storeId) == request.auth.uid || role() == 'admin');
        allow update: if isSignedIn() && (storeSellerId(storeId) == request.auth.uid || role() == 'admin');
        allow delete: if false;
      }
    }

    // ---- shared CJ catalog -------------------------------------------
    // Written only by the syncCjCatalog Cloud Function (admin SDK
    // bypasses rules); readable by any signed-in seller browsing to list.
    match /catalog/{productId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ---- seller listings ----------------------------------------------
    match /listings/{listingId} {
      allow read: if true; // storefront is browsable by buyers, incl. guests if you allow guest browsing
      // A seller can only create a listing under their own sellerId, and
      // can only update a listing that's already theirs — role() == 'seller'
      // alone let any seller edit any other seller's listing.
      allow create: if isSignedIn() && role() == 'seller' &&
        request.resource.data.sellerId == request.auth.uid;
      allow update: if isSignedIn() && role() == 'seller' &&
        resource.data.sellerId == request.auth.uid &&
        request.resource.data.sellerId == resource.data.sellerId;
      allow delete: if false;
    }

    // ---- orders ---------------------------------------------------------
    // Orders are created only by the createOrder Cloud Function (Admin SDK
    // bypasses these rules), which re-prices from listings server-side —
    // a client-created order would carry a self-reported total/fee. See
    // functions/src/orders.ts.
    match /orders/{orderId} {
      allow create: if false;
      allow read: if isSignedIn() &&
        (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid || role() == 'admin');
      allow update: if isSignedIn() && (resource.data.sellerId == request.auth.uid || role() == 'admin');
      allow delete: if false;
    }

    // ---- subscription plans ---------------------------------------------
    match /subscription_plans/{planId} {
      allow read: if true;
      allow write: if isSignedIn() && role() == 'admin';
    }

    // ---- billing history ------------------------------------------------
    match /billing_history/{entryId} {
      allow read: if isSignedIn() && (resource.data.sellerId == request.auth.uid || role() == 'admin');
      allow write: if false; // written by Cloud Functions only
    }

    // ---- current subscription state --------------------------------------
    // One doc per seller (id == sellerId), upserted only by intasendWebhook
    // on payment confirmation. Never client-writable — a future orderLimit
    // check would read this doc, so a client write here could grant a
    // seller an unlimited order quota.
    match /subscriptions/{sellerId} {
      allow read: if isOwner(sellerId) || role() == 'admin';
      allow write: if false;
    }
  }
}
